# Public values supplied by the Supabase project API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_ or import it in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin used for OAuth and magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Code-only demonstration Humans for the homepage globe. Set false before launch.
NEXT_PUBLIC_SHOW_GLOBE_MOCKS=true
