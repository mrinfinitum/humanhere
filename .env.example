# Neon Postgres owner connection. Server-only; never expose to the browser.
DATABASE_URL=

# Copy both URLs from Neon Console after enabling Data API and Managed Better Auth.
NEON_DATA_API_URL=
NEON_AUTH_BASE_URL=
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
# Enable in Neon Console before setting the corresponding flag to true.
NEON_AUTH_MAGIC_LINK_ENABLED=false
NEON_AUTH_GOOGLE_ENABLED=false

# Neon Object Storage S3 credentials (all server-only).
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Public URL: <AWS_ENDPOINT_URL_S3>/published-media (no credentials).
NEXT_PUBLIC_MEDIA_BASE_URL=

# Canonical origin used for OAuth and magic-link redirects. Production must use HTTPS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Code-only development Humans. Set false to hide locally; production always disables them.
NEXT_PUBLIC_SHOW_GLOBE_MOCKS=true

# Temporary server-only /world demonstration. Set false to restore the real
# public-data-only World without changing code.
WORLD_DEMO_ENABLED=true

# Development-only globe diagnostics/showcase controls. Keep both false in hosted environments.
NEXT_PUBLIC_GLOBE_DEBUG=false
NEXT_PUBLIC_SHOW_ALL_GLOBE_BEACONS=false

# Server-only tangible-help gate. Keep false until a separately reviewed launch.
SHOW_UP_ENABLED=false
